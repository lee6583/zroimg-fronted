    "features": {
      "eyebrow": "Возможности",
      "title": "Всё необходимое для творчества",
      "text": "От одной подсказки до готового набора изображений: идеи, стили, референсы и результаты — в одном месте.",
      "items": {
        "conversation": {
          "title": "Творчество в диалоге",
          "text": "Описывайте сцену как в чате: персонажей, место, свет и стиль можно уточнять фраза за фразой."
        },
        "styles": {
          "title": "Множество стилей",
          "text": "Фотореализм, аниме, акварель, масло, минималистичные постеры, предметная съёмка — подходящий образ для любой задачи."
        },
        "batch": {
          "title": "Пакетный поиск",
          "text": "Создавайте сразу несколько вариантов, чтобы искать направление, сравнивать композиции и быстро развивать идеи."
        },
        "reference": {
          "title": "Работа с референсом",
          "text": "Загрузите референс: сохраните объект, замените фон или стиль — и дайте старым материалам новую жизнь."
        },
        "hd": {
          "title": "Вывод в HD",
          "text": "Подходит для аватаров, обложек, постеров, фото товаров и соцсетей — работы сразу готовы к использованию."
        },
        "credits": {
          "title": "Гибкие кредиты",
          "text": "Покупайте кредиты по мере необходимости и платите только за генерации — для проб и для постоянной работы."
        }
      }
    },
    "steps": {
      "eyebrow": "Как это работает",
      "title": "От идеи до изображения за четыре шага",
      "text": "Не нужен ни опыт дизайна, ни хитрости с подсказками — начните творить за пару минут.",
