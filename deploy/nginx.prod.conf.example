# 生产站点配置（宿主机 nginx，/etc/nginx/sites-available/zroimg.com）。
# 依赖 /etc/nginx/snippets/zroimg-proxy.conf 与 zroimg-cloudflare-realip.conf，见 deploy/README.md。
server {
    listen 80;
    listen [::]:80;
    server_name zroimg.com www.zroimg.com api.zroimg.com;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; default_type text/plain; }
    location / { return 301 https://$host$request_uri; }
}

# 前端站点：页面走 Next.js，/api/* 去掉前缀后直连 Java
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name zroimg.com;
    ssl_certificate /etc/letsencrypt/live/zroimg.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zroimg.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    include /etc/nginx/snippets/zroimg-cloudflare-realip.conf;
    client_max_body_size 20m;

    location /api/ {
        proxy_pass http://127.0.0.1:18081/;
        include /etc/nginx/snippets/zroimg-proxy.conf;
        proxy_read_timeout 300s;
    }

    location / {
        proxy_pass http://127.0.0.1:13000;
        include /etc/nginx/snippets/zroimg-proxy.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# 后端 API 域名：支付回调、生成供应商回源等外部调用
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.zroimg.com;
    ssl_certificate /etc/letsencrypt/live/api.zroimg.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.zroimg.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    include /etc/nginx/snippets/zroimg-cloudflare-realip.conf;
    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:18081;
        include /etc/nginx/snippets/zroimg-proxy.conf;
        proxy_read_timeout 300s;
    }
}
